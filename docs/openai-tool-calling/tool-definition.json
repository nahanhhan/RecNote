{
  "type": "function",
  "function": {
    "name": "save_class_notes",
    "description": "保存当前录音、当前整理批次的笔记。写作要求由系统提示词指定，来源编号必须来自本次输入。",
    "strict": true,
    "parameters": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "本次课堂笔记的标题"
        },
        "sections": {
          "type": "array",
          "description": "按课堂讲解顺序排列的笔记部分",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string",
                "description": "本部分的小标题"
              },
              "markdown": {
                "type": "string",
                "description": "本部分的笔记正文，支持 Markdown、代码块和数学公式。图片由 App 根据 photo_ids 插入。"
              },
              "source_segment_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "本部分依据的转写段落编号，须来自当前输入"
              },
              "photo_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "本部分使用的照片编号，须来自当前输入；无图片时为空数组"
              }
            },
            "required": [
              "heading",
              "markdown",
              "source_segment_ids",
              "photo_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "sections"
      ],
      "additionalProperties": false
    }
  }
}
